# Runtime configuration for the agenticwf-kb container (docker/podman --env-file).
# Install as /etc/agenticwf/kb.env. Knowledge settings (database, retrieval, models) are in
# /etc/agenticwf/kb.cfg instead (docs/configuration.md).

# Who authenticates requests (docs/run-modes.md):
#   standalone (default)  a personal KB for one user on this machine: one access token, created
#                         on first boot; the sign-in link is printed to the logs
#   authsvc               behind Caddy + the AgenticWF auth service
#   service               the agent's backend: no authentication; X-KB-Principal names the user
# KB_AUTH_MODE=standalone

# --- standalone ---
# The address browsers use (the published port), for the printed sign-in link.
# KB_PUBLIC_URL=http://localhost:8766
# The one user: subject local:<KB_LOCAL_USER>. Use your personal agent's login, so both agree on
# the owner of what you add.
# KB_LOCAL_USER=wguan
# The token itself, instead of a generated one (at least 16 characters); otherwise print it with
# `docker exec agenticwf-kb agenticwf-kb token`.
# KB_TOKEN=

# --- authsvc ---
# AuthContext secret shared with authsvc: a read-only mount (preferred), or the value, which the
# entrypoint moves into /var/lib/agenticwf-kb/secrets.
# AUTH_CONTEXT_SECRET_FILE=/run/secrets/auth_context_secret
# AUTH_CONTEXT_SECRET=
# AUTH_BIND_REQUEST=true
# Must match `required_scopes` in AgenticWF-auth's policy.yaml (account approval).
# KB_REQUIRED_SCOPES=app:access

# --- the agent's listener (next to standalone or authsvc) ---
# A Unix socket in a volume shared with the agent (recommended), or host:port. A non-loopback
# address needs KB_SERVICE_ALLOW_REMOTE=true: use it only on a network that just the agent joins.
# KB_SERVICE_LISTEN=unix:/run/agenticwf-kb/kb.sock
# KB_SERVICE_ALLOW_REMOTE=false
# The scopes a forwarded user may carry at most (admin is never accepted unless listed).
# KB_SERVICE_SCOPES_CAP=knowledge:read knowledge:write

# --- listener and processes ---
# Main listener. standalone default 0.0.0.0 (publish -p 127.0.0.1:8766:8020); authsvc and service
# default 127.0.0.1 (--network host). unix:/path listens on a Unix socket.
# LISTEN_HOST=127.0.0.1
# PORT=8020
# LOG_LEVEL=info
# KB_BASE_PATH=/kb
# Worker processes beside the API process; 0 (default) runs the tasks in the API process.
# KB_WORKER_PROCESSES=2

# The key that encrypts secrets stored in the database (model API keys). Created on first boot in
# /var/lib/agenticwf-kb/secrets/secrets_key; losing it makes stored secrets unreadable.
# KB_SECRETS_KEY_FILE=/var/lib/agenticwf-kb/secrets/secrets_key

# Model provider credentials, named by api_key_env in kb.cfg [models.*] (phase 1).
# EMBEDDINGS_API_KEY=
# OPENAI_API_KEY=

# OpenTelemetry (docs/deployment.md, Tracing and metrics): off unless an OTLP endpoint is set.
# Traces of requests, searches, agentic searches, model calls and tasks go over OTLP/HTTP to a
# collector, e.g. Jaeger on the same Docker network (its port 4318); calls from the agent join the
# agent's traces. Services: agenticwf-kb, agenticwf-kb-service, agenticwf-kb-worker.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Metrics need a collector that takes them (Jaeger does not), e.g. Prometheus's OTLP receiver:
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
